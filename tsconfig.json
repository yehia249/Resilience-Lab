{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "paths": { "@lab/common": ["./packages/common/src/index.ts"] }
  },
  "include": ["apps", "packages", "scripts", "e2e", "vitest.config.ts", "playwright.config.ts"]
}

{
  "name": "resilience-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lab/web dev",
    "build": "pnpm --filter @lab/common build && pnpm --filter @lab/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/record.ts",
    "record": "tsx scripts/record.ts",
    "start:service": "tsx apps/runtime/src/main.ts",
    "test:e2e": "playwright test",
    "infra:generate": "tsx scripts/generate-k8s.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "fastify": "5.12.7",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.6",
    "esbuild": "0.25.12",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12",
    "yaml": "2.8.3"
  }
}
